# 定義集合的大小
param m := 2; # Hub 醫院數量 
param n := 4; # Spoke 醫院數量 

# 政府部門參數 (s[i] 已改為政府層變數，不在此給值)
# 注意: alpha/beta 需大於約 365 政府才會補助 (s 必須 > c_hub + c_spoke = 240 才能讓 Hub 降價擴量)
param alpha := 1000;     # 平衡醫療需求分配(服務病患數)權重
param beta  := 1;        # 政府補助支出權重
param S     := 1000000;  # 總政府補助預算

# Hub 醫院參數 (索引 i 從 1 到 M) 
param c_hub := 
1 200
2 200;   # Hub 醫院單位成本

param gamma := 0.03;		
param theta1 := 1.2;  # 收入支出比率限制 
param theta2 :=  0.05;  # 容量增加與成本減少權重

param B_hub := 
1 125000
2 125000; # Hub 醫院預算 

# Spoke 醫院參數 
param T := 
1 2000, 2 2000, 3 2000, 4 2000;

param delta := 1;             # 資源分配平衡懲罰項權重 

#大M懲罰值
param M_penalty := 1000;

#preference
param pref_noise : 1 2 3 4 :=
1  0.2  4.1  1.5 2.0
2  3.3  0.8  2.7 1.0;

param c_spoke := 
1 40, 2 40, 3 40, 4 40; # Spoke 醫院單位成本

param B_spoke := 
1 20000, 2 50000,3 50000, 4 100000; # Spoke 醫院預算
